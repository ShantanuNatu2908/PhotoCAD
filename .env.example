# ==============================================================================
# PhotoCAD - Cloud Foundation Environment Configuration (Phase 1)
# Document ID: PCAD-SAD-002
# ==============================================================================

# 1. Core API & Server
PROJECT_NAME="PhotoCAD"
API_V1_PREFIX="/api/v1"
ENVIRONMENT="development"  # "development" | "production"
PORT=8000

# 2. Database (PostgreSQL 16 + pgvector on Supabase)
# In development, a local sqlite+aiosqlite fallback is supported if Supabase is offline.
DATABASE_URL="sqlite+aiosqlite:///storage/photocad.db"
# Example Supabase: postgresql+asyncpg://postgres:[PASSWORD]@[HOST]:5432/postgres
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# 3. Cache & Queue (Redis on Upstash / Redis Cloud)
# Used for ARQ async jobs, LangGraph checkpoints, and WebSocket pub/sub.
REDIS_URL="redis://default:your-password@your-endpoint.upstash.io:6379"

# 4. Binary Blob Storage (Cloudflare R2 - S3-Compatible)
# Used for raw PNG keyframes, .PLY point clouds, and .STEP/.DXF/.STL artifacts.
CLOUDFLARE_R2_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_R2_ACCESS_KEY_ID="your-r2-access-key-id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
CLOUDFLARE_R2_BUCKET_NAME="photocad-assets"
CLOUDFLARE_R2_PUBLIC_URL="https://r2.photocad.app"

# 5. Serverless Cloud GPU (Modal)
# Used for SAM 2.1, Depth Anything 3, and Open3D ICP point cloud fusion.
MODAL_TOKEN_ID="your-modal-token-id"
MODAL_TOKEN_SECRET="your-modal-token-secret"

# 6. LLM Providers
GEMINI_API_KEY="your-gemini-api-key"
DEFAULT_LLM_MODEL="gemini-3.5-flash"  # or gemini-3.1-flash-lite
ANTHROPIC_API_KEY="your-anthropic-api-key"

# 7. Auth & Multi-Tenancy (v1.1)
# Leave both JWT secrets empty only for local development (tenant="public" bypass).
# In production set one HS256 secret; optionally pin JWT_ISSUER to your Supabase project URL.
JWT_SECRET=""
SUPABASE_JWT_SECRET=""
JWT_ISSUER=""

# 8. Smooth Surfaces (v1.1 opt-in)
# Adds C2 B-spline OPEN_SHELL metadata to visual_hull.json. The watertight STEP remains faceted.
PHOTOCAD_SMOOTH_SURFACES="false"

# 9. Observability (Optional)
LANGSMITH_API_KEY="your-langsmith-api-key"
LANGCHAIN_TRACING_V2="false"
